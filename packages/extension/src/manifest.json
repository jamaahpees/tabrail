{
  "manifest_version": 3,
  "name": "Remote Browser Bridge",
  "version": "0.1.0",
  "description": "Let a local MCP agent read and control your real Chrome tabs through a loopback bridge.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "debugger",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Remote Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
